// The typecheck has three projects, one for each place the code runs (bun run typecheck checks all three):
//
//   tsconfig.json           the tools: what runs under Bun (deploy/, dev/, tests/, e2e/, the build scripts), DOM and Bun types
//   tsconfig.workers.json   the Worker: server/, document/, agents/, cloudflare/, Workers types, no DOM
//   tsconfig.browser.json   the browser: client/ and shared/, DOM types, no Bun
//
// A file a project imports is checked with that project's types too: shared/ under all three.
// tests/typecheck.test.ts fails on a .ts file that no project names.
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["bun"]
  },
  "include": [
    "shared/text-imports.d.ts",
    "bench",
    "deploy",
    "dev",
    "tests",
    "e2e",
    "e2e.config.ts",
    "vite.config.ts",
    "client/build.ts",
    "assets/logo"
  ],
  // They test Worker files with the Workers' types: tsconfig.workers.json checks them.
  "exclude": ["tests/document-host.test.ts", "tests/render-browser.test.ts"]
}
