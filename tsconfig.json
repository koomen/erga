{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["bun"]
  },
  "include": ["text-imports.d.ts", "src", "dev.ts", "dev", "vite.config.ts", "front.ts", "host.ts", "migrate.ts", "agent.ts", "room.ts", "workspace.ts", "tests/suite", "tests/tab.ts", "tests/cdp.ts", "tests/worker.ts", "tests/host.ts"]
}
