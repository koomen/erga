{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["bun"]
  },
  "include": ["text-imports.d.ts", "src", "dev.ts", "dev", "vite.config.ts", "front.ts", "host.ts", "agent.ts", "room.ts", "workspace.ts", "deploy", "landing-publish.ts", "tests/deploy.test.ts", "tests/pipeline.test.ts", "source", "tests/source.test.ts", "tests/source-fixture.ts", "e2e", "e2e.config.ts", "e2e.bench.config.ts"],
  "exclude": ["deploy/builder/worker.ts", "deploy/index.ts"]
}
