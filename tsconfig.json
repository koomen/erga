{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["bun"]
  },
  "include": ["shared/text-imports.d.ts", "shared", "document", "agents/models.ts", "client", "dev", "vite.config.ts", "server/routes.ts", "server/doc-host.ts", "editor-agent/session.ts", "document/room.ts", "editor-agent/workspace.ts", "deploy", "server/source", "e2e", "e2e.config.ts", "tests/deploy.test.ts", "tests/pipeline.test.ts", "tests/source.test.ts", "tests/source-fixture.ts"],
  "exclude": ["deploy/builder/worker.ts", "deploy/hook.ts"]
}
