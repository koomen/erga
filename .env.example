# The page editor's embedded agent (agent.ts). Copy to .env (gitignored) and fill in.
ANTHROPIC_API_KEY=

# Optional. Defaults shown.
# The model each person's agent starts on: sonnet (Claude Sonnet 5.5) or
# opus-fast (Claude Opus 5.5 in fast mode, Claude API only). Each person can
# switch from the agent panel.
ERGA_AGENT_MODEL=sonnet
# low | medium | high | xhigh | max
ERGA_AGENT_EFFORT=medium
