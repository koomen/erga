// The Workers (the app's and the control Worker's): Cloudflare's runtime types (.cloudflare/types, which
// `bun run typecheck` makes from cloudflare.config.ts first), Node's (the Workers run with nodejs_compat: node:crypto,
// node:async_hooks), no DOM and no Bun. See tsconfig.json.
{
  "extends": "./tsconfig.json",
  "compilerOptions": { "lib": ["ES2022"], "types": ["node"] },
  "include": [
    "shared/text-imports.d.ts",
    ".cloudflare/types",
    "server",
    "document",
    "agents",
    "control",
    "cloudflare",
    // A library's API needs no browser: the document's object runs it for agents.
    "libs/*/api",
    "cloudflare.config.ts",
    // A test of a Worker file: bun:test's types alone, with the Workers' own.
    "node_modules/bun-types/test.d.ts",
    "tests/document-host.test.ts"
  ],
  // The build container's server runs under Bun: tsconfig.json checks it.
  "exclude": ["control/builder/build.ts", "control/builder/server.ts"]
}
