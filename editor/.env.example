# The page editor's embedded agent (agent.ts). Copy to .env (gitignored) and fill in.
ANTHROPIC_API_KEY=

# Optional. Defaults shown.
SCRATCHWORK_AGENT_MODEL=claude-opus-5-5
# "fast" (Opus fast mode, 2x price, Claude API only) or "standard"
SCRATCHWORK_AGENT_SPEED=fast
# low | medium | high | xhigh | max
SCRATCHWORK_AGENT_EFFORT=medium
