#!/usr/bin/env bun
// tq: the task queue from the command line (development/task-queue/server.ts),
// starting the server first if it isn't running. Prints the task as JSON.
//
//   tq add "title" ["description"] [--live] [--after 12,13] [--merge-after 14]
//                                        register a task: branch, worktree, preview port (--live: a live task);
//                                        --after: don't start it until those tasks are merged; --merge-after: don't
//                                        merge it until they are (build in parallel, land in order)
//   tq deps ID [--after IDS|none] [--merge-after IDS|none] [--clear]
//                                        show or change a task's dependencies (each list replaces the old one;
//                                        --clear removes both); prints the task, with blockedBy if it waits
//   tq start ID [--agent AGENT] ["message"]
//                                        status: working; --agent records the agent doing it (the Agent tool's agent
//                                        id), the one to wake if its merge needs work
//   tq agent ID AGENT                    record (or change) the task's agent
//   tq log ID "message"                  a progress line on the card
//   tq preview ID [path] [--cmd "..."]   run the task's app in its worktree on its port ($PORT)
//   tq preview ID --stop                 stop it (e.g. before a build in the worktree that it gets in the way of)
//   tq shot ID URL-or-FILE ["caption"] [--replace]
//                                        attach a screenshot (a URL is taken with headless Chrome); --replace removes
//                                        the task's screenshots first (for a fresh pass)
//   tq unshot ID FILE|INDEX | --all      remove a screenshot (by file name, or 1-based index), or all of them
//   tq live ID [path] [--cmd "..."]      live mode: marks the task live, runs its dev server with live reload on its
//                                        port, and opens its own Chrome window on it (or brings it back); prints the task
//   tq look ID [--shot [FILE]] [--console]
//                                        what the live task's Chrome window shows: the tab in front (url, title), every
//                                        tab, selected text and console errors; --shot saves a screenshot (prints its
//                                        path), --console all console messages
//   tq url ID URL                        where the user should look
//   tq done ID "summary" [URL]           status: complete, waiting for the user to merge
//   tq fail ID "why"                     status: failed
//   tq merge ID [--wait]                 what the board's Merge does: status merging, then merged, needs-agent
//                                        (the task's agent must fix something: needsAgent says what), or back to
//                                        complete with the reason; --wait waits and exits 1 if it didn't merge
//   tq continue ID [--wait]              the task's agent, after fixing what stopped the merge (needs-agent) and
//                                        committing: merge again
//   tq restart                           restart the queue with the code on disk, once nothing is merging
//   tq discard ID                        what the board's Discard does
//   tq release [COMMIT]                  move origin's main to its staging head (or to COMMIT, one of staging's
//                                        commits): for Erga, production (erga.dev) to staging. Only when someone asks
//   tq get ID | tq list [STATUS]         read (list shows each task's dependencies, and what blocks it)
//   tq serve                             just make sure the server is up; prints the board's address
//   tq watch [--state FILE]              stay running, printing one line per task status change
//                                        ("#3 merged: title", "#4 failed: title: why", "#5 needs agent: title:
//                                        conflicts merging main: a.ts (agent ID)"), and when a task's
//                                        dependencies change it ("#14 unblocked: title (#12 merged)": start it;
//                                        "#15 unblocked for merge: title (#12 merged)"; "#16 blocked: title: why"),
//                                        and when signing in to origin needs someone ("origin sign-in: open URL
//                                        and approve it (code ABCD)": tell the user), and nothing else;
//                                        reconnects (restarting the queue if need be) when the server goes away.
//                                        --state keeps what it has seen in FILE, so a new watch (say, re-armed
//                                        after a Monitor timeout) reports what changed in between
//
// Statuses: queued → working → complete (Ready to merge) → merging → merged (on its commit in Branches);
// also needs-agent (the merge waits for the task's agent: tq continue), failed and discarded. Agents set queued,
// working, complete and failed.
// Dependencies: tq start refuses a task whose --after tasks aren't merged, and tq merge one whose --after or
// --merge-after tasks aren't (the server answers 409 with the reason). A task's blockedBy says what it waits for.
//
// TASK_QUEUE_PORT picks the port (4700).

import { spawn } from "node:child_process";
import { existsSync, mkdirSync, openSync } from "node:fs";
import { dirname, join, resolve } from "node:path";

const PORT = Number(process.env.TASK_QUEUE_PORT ?? 4700);
const BASE = `http://127.0.0.1:${PORT}`;
// The main checkout's copy, even when run from a task's worktree.
const git = Bun.spawnSync(["git", "rev-parse", "--path-format=absolute", "--git-common-dir"], { cwd: import.meta.dir });
const MAIN_COPY = join(dirname(git.stdout.toString().trim()), "development/task-queue");
const HERE = git.exitCode == 0 && existsSync(join(MAIN_COPY, "server.ts")) ? MAIN_COPY : import.meta.dir;

async function up() {
  try { return (await fetch(`${BASE}/api`, { signal: AbortSignal.timeout(1000) })).ok; } catch { return false; }
}

async function ensureServer() {
  if (await up()) return restartIfTooOld();
  const data = join(HERE, "data");
  mkdirSync(data, { recursive: true });
  const log = openSync(join(data, "server.log"), "a");
  spawn("bun", [join(HERE, "server.ts")], { detached: true, stdio: ["ignore", log, log], env: process.env }).unref();
  for (let i = 0; i < 100; i++) { if (await up()) return; await Bun.sleep(100); }
  console.error(`task queue didn't start: see ${join(data, "server.log")}`);
  process.exit(1);
}

/**
 * A queue started before it could restart itself (its GET /api has no `running`) never picks up new code by itself:
 * restart it here, by hand, when nothing is merging. (One that has `running` restarts itself when its code changes.)
 */
let restartedOld = false;
async function restartIfTooOld() {
  if (restartedOld) return;
  const about = await fetch(`${BASE}/api`).then((r) => r.json(), () => null);
  if (!about || about.running || !about.pid) return;
  // Only when the code on disk is new enough to do it itself from then on.
  if (!require("node:fs").readFileSync(join(HERE, "server.ts"), "utf8").includes("CODE_VERSION")) return;
  restartedOld = true;
  const tasks = await fetch(`${BASE}/api/tasks`).then((r) => r.json(), () => []);
  if (tasks.some((t: any) => t.status == "merging")) return;
  console.error(`tq: the task queue (pid ${about.pid}) runs code too old to restart itself: restarting it`);
  try { process.kill(about.pid, "SIGTERM"); } catch {}
  for (let i = 0; i < 100 && (await up()); i++) await Bun.sleep(100);
  await ensureServer();
}

async function call(method: string, path: string, body?: unknown) {
  const res = await fetch(BASE + path, { method, headers: body ? { "content-type": "application/json" } : {}, body: body ? JSON.stringify(body) : undefined });
  const data = await res.json();
  if (!res.ok) { console.error(data.error ?? JSON.stringify(data)); process.exit(1); }
  return data;
}

const argv = process.argv.slice(2);
const liveFlag = argv[0] == "add" && argv.includes("--live") && !!argv.splice(argv.indexOf("--live"), 1);
/** add and deps: --after, --merge-after (a list of ids, or "none") and --clear, taken out of argv wherever they are. */
const depFlags: Record<string, unknown> = {};
if (argv[0] == "add" || argv[0] == "deps") {
  const take = (name: string) => { const i = argv.indexOf(name); if (i < 0) return undefined; const v = argv.splice(i, 2)[1]; if (v == undefined) { console.error(`${name} needs task ids (12,13) or none`); process.exit(2); } return v; };
  const list = (v: string) => (v == "none" ? [] : v.split(",").map((x) => x.trim().replace(/^#/, "")).filter(Boolean));
  const clear = argv.includes("--clear") && !!argv.splice(argv.indexOf("--clear"), 1);
  if (clear) Object.assign(depFlags, { startAfter: [], mergeAfter: [] });
  const after = take("--after"), mergeAfter = take("--merge-after");
  if (after != undefined) depFlags.startAfter = list(after);
  if (mergeAfter != undefined) depFlags.mergeAfter = list(mergeAfter);
}
const [cmd, id, ...rest] = argv;
const flag = (name: string) => { const i = rest.indexOf(name); return i >= 0 ? rest.splice(i, 2)[1] : undefined; };
const has = (name: string) => { const i = rest.indexOf(name); return i >= 0 && !!rest.splice(i, 1); };
const need = (v: unknown, usage: string) => { if (!v) { console.error(`usage: tq ${usage}`); process.exit(2); } };

if (!cmd || cmd == "help" || cmd == "--help") {
  const lines = require("node:fs").readFileSync(import.meta.path, "utf8").split("\n").slice(1);
  console.log(lines.slice(0, lines.findIndex((l: string) => !l.startsWith("//"))).map((l: string) => l.slice(3)).join("\n"));
  process.exit(0);
}
await ensureServer();
if (cmd == "watch") await watch(flag("--state") ?? (id == "--state" ? rest.shift() : undefined));
let out: unknown;
switch (cmd) {
  case "serve": out = { board: `http://localhost:${PORT}/`, api: `http://localhost:${PORT}/api` }; break;
  case "add": need(id, 'add "title" ["description"] [--live] [--after IDS] [--merge-after IDS]'); out = await call("POST", "/api/tasks", { title: id, description: rest[0] ?? "", ...(liveFlag ? { live: true } : {}), ...depFlags }); break;
  case "deps": {
    need(id, "deps ID [--after IDS|none] [--merge-after IDS|none] [--clear]");
    out = Object.keys(depFlags).length ? await call("PATCH", `/api/tasks/${id}`, depFlags) : await call("GET", `/api/tasks/${id}`);
    const t: any = out;
    out = { id: t.id, title: t.title, status: t.status, startAfter: t.startAfter ?? [], mergeAfter: t.mergeAfter ?? [], ...(t.blockedBy ? { blockedBy: t.blockedBy } : {}) };
    break;
  }
  case "live": { need(id, "live ID [path] [--cmd ...]"); const command = flag("--cmd"); out = await call("POST", `/api/tasks/${id}/live`, { path: rest[0], command }); break; }
  case "look": {
    need(id, "look ID [--shot [FILE]] [--console]");
    const i = rest.indexOf("--shot"), file = i >= 0 && rest[i + 1] && !rest[i + 1].startsWith("--") ? resolve(rest[i + 1]) : undefined;
    const params = new URLSearchParams({ ...(i >= 0 ? { shot: "1" } : {}), ...(rest.includes("--console") ? { console: "1" } : {}) });
    out = await call("GET", `/api/tasks/${id}/look?${params}`);
    if (file && (out as any).screenshot) { require("node:fs").copyFileSync((out as any).screenshot, file); (out as any).screenshot = file; }
    break;
  }
  case "start": { need(id, "start ID [--agent AGENT]"); const agent = flag("--agent"); out = await call("PATCH", `/api/tasks/${id}`, { status: "working", message: rest[0] ?? "Started", ...(agent ? { agent } : {}) }); break; }
  case "agent": need(id && rest[0], "agent ID AGENT"); out = await call("PATCH", `/api/tasks/${id}`, { agent: rest[0] }); break;
  case "restart": out = await call("POST", "/api/restart"); break;
  case "log": need(id && rest[0], 'log ID "message"'); out = await call("POST", `/api/tasks/${id}/log`, { message: rest[0] }); break;
  case "preview": {
    need(id, "preview ID [path] [--cmd ...] | --stop");
    if (has("--stop")) { out = await call("DELETE", `/api/tasks/${id}/preview`); break; }
    const command = flag("--cmd"); out = await call("POST", `/api/tasks/${id}/preview`, { path: rest[0], command }); break;
  }
  case "url": need(id && rest[0], "url ID URL"); out = await call("PATCH", `/api/tasks/${id}`, { url: rest[0] }); break;
  case "shot": {
    const replace = has("--replace");
    need(id && rest[0], 'shot ID URL-or-FILE ["caption"] [--replace]');
    const [target, caption] = rest;
    if (replace) await call("DELETE", `/api/tasks/${id}/screenshots`);
    out = await call("POST", `/api/tasks/${id}/screenshots`, /^https?:/.test(target) ? { url: target, caption } : { path: resolve(target), caption });
    break;
  }
  case "unshot": {
    const all = has("--all");
    need(id && (all || rest[0]), "unshot ID FILE|INDEX | --all");
    out = await call("DELETE", `/api/tasks/${id}/screenshots${all ? "" : `/${encodeURIComponent(rest[0])}`}`);
    break;
  }
  case "done": need(id && rest[0], 'done ID "summary" [URL]'); out = await call("PATCH", `/api/tasks/${id}`, { status: "complete", summary: rest[0], ...(rest[1] ? { url: rest[1] } : {}), message: "Complete: ready to merge" }); break;
  case "fail": need(id && rest[0], 'fail ID "why"'); out = await call("PATCH", `/api/tasks/${id}`, { status: "failed", error: rest[0], message: `Failed: ${rest[0]}` }); break;
  case "merge": case "continue": {
    need(id, `${cmd} ID [--wait]`);
    out = await call("POST", `/api/tasks/${id}/${cmd}`);
    if (!has("--wait")) break;
    let t: any = out;
    while (t.status == "merging") { await Bun.sleep(500); t = await call("GET", `/api/tasks/${id}`); }
    out = t;
    if (t.status != "merged") {
      console.log(JSON.stringify(t, (k, v) => (k == "log" && Array.isArray(v) ? v.slice(-5) : v), 2));
      console.error(t.status == "needs-agent" ? `merge stopped, needs agent: ${t.error}` : `merge failed: ${t.error ?? t.status}`);
      process.exit(1);
    }
    break;
  }
  case "release": {
    const res = await fetch(`${BASE}/api/release`, { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify(id ? { commit: id } : {}) });
    const r = await res.json();
    console.log(r.said ?? JSON.stringify(r));
    process.exit(r.ok ? 0 : 1);
  }
  case "discard": need(id, "discard ID"); out = await call("POST", `/api/tasks/${id}/discard`); break;
  case "get": need(id, "get ID"); out = await call("GET", `/api/tasks/${id}`); break;
  case "list": out = (await call("GET", `/api/tasks${id ? `?status=${id}` : ""}`)).map((t: any) => ({ id: t.id, status: t.status, title: t.title, url: t.url, branch: t.branch,
    ...(t.startAfter ? { startAfter: t.startAfter } : {}), ...(t.mergeAfter ? { mergeAfter: t.mergeAfter } : {}), ...(t.blockedBy ? { blockedBy: t.blockedBy.reason } : {}) })); break;
  default: console.error(`unknown command ${cmd}: tq help`); process.exit(2);
}
console.log(JSON.stringify(out, (k, v) => (k == "log" && Array.isArray(v) ? v.slice(-5) : v), 2));

/**
 * tq watch: follows GET /api/events, printing one line per task whose status changed (new tasks too), and one
 * when a task's dependencies unblock it (it can start, or merge) or block it for good (a dependency discarded or failed).
 */
async function watch(stateFile?: string): Promise<never> {
  const fs = require("node:fs");
  // Per task: its status, and what blocks it ("s:12,13" can't start, "m:12" can't merge, "x:12" stuck, "" nothing).
  type Seen = { status: string; blocked?: string };
  let seen: Map<number, Seen> | undefined;
  if (stateFile) try {
    seen = new Map(Object.entries(JSON.parse(fs.readFileSync(stateFile, "utf8"))).map(([k, v]: [string, any]) => [Number(k), typeof v == "string" ? { status: v } : v]));
  } catch {}
  const say = (line: string) => fs.writeSync(1, line + "\n"); // unbuffered: each line goes out at once
  const label: Record<string, string> = { complete: "ready to merge", "needs-agent": "needs agent" };
  const blockKey = (t: any) => { const b = t.blockedBy; return !b ? "" : b.stuck.length ? `x:${b.stuck}` : b.start.length ? `s:${b.start}` : `m:${b.merge}`; };
  const changed = (tasks: any[]) => {
    const first = !seen;
    const before = seen ?? new Map<number, Seen>();
    seen = new Map(tasks.map((t) => [t.id, { status: t.status, blocked: blockKey(t) }]));
    if (stateFile) try { fs.writeFileSync(stateFile, JSON.stringify(Object.fromEntries(seen))); } catch {}
    if (first) return; // the first snapshot is the baseline
    const byId = new Map(tasks.map((t) => [t.id, t]));
    const gone = (key: string | undefined, now: string) => { // ids that blocked it before and don't now, and why
      const was = (key ?? "").slice(2).split(",").filter(Boolean).map(Number), still = now.slice(2).split(",").map(Number);
      return was.filter((id) => !still.includes(id)).map((id) => `#${id} ${byId.get(id)?.status == "merged" ? "merged" : "no longer a dependency"}`).join(", ");
    };
    for (const t of tasks) {
      const was = before.get(t.id), key = blockKey(t);
      if (was?.status != t.status) {
        const why = t.status == "failed" || (t.status == "complete" && was?.status == "merging") ? t.error
          : t.status == "needs-agent" ? `${String(t.error).replace(/\s+/g, " ").slice(0, 240)} (${t.agent ? `agent ${t.agent}` : "no agent recorded"})`
          : t.status == "queued" && t.blockedBy ? t.blockedBy.reason : undefined;
        const what = t.status == "complete" && was?.status == "merging" ? "merge failed, back to ready to merge" : label[t.status] ?? t.status;
        say(`#${t.id} ${what}: ${t.title}${why ? `: ${String(why).replace(/\s+/g, " ").slice(0, 300)}` : ""}`);
        if (was) continue; // a new task's line says what blocks it
      }
      if (!was || was.blocked == undefined || was.blocked == key || ["merged", "discarded"].includes(t.status)) continue;
      // Unblocked: a queued task can start (nothing stops its start), or a task ready to merge can merge.
      if (t.status == "queued" && was.blocked.startsWith("s:") && !key.startsWith("s:") && !key.startsWith("x:")) say(`#${t.id} unblocked: ${t.title} (${gone(was.blocked, key)})`);
      else if (t.status == "complete" && was.blocked && !key) say(`#${t.id} unblocked for merge: ${t.title} (${gone(was.blocked, key)})`);
      else if (key.startsWith("x:") && !was.blocked.startsWith("x:")) say(`#${t.id} blocked: ${t.title}: ${t.blockedBy.reason}`);
    }
  };
  // Signing in to origin waits for someone to approve this machine: say where, once per request.
  let toldLogin = "";
  const loginNews = (login: any) => {
    const url = login?.approve_url ?? "";
    if (url && url != toldLogin) say(`origin sign-in: open ${url} and approve it (code ${login.user_code}), so the queue can fetch and push`);
    toldLogin = url;
  };
  for (let misses = 0; ; ) {
    const ctrl = new AbortController();
    let quiet: Timer | undefined;
    const idle = () => { clearTimeout(quiet); quiet = setTimeout(() => ctrl.abort(), 40000); }; // the server beats every 15s
    try {
      idle();
      const res = await fetch(`${BASE}/api/events`, { signal: ctrl.signal });
      if (!res.ok || !res.body) throw new Error(String(res.status));
      misses = 0;
      const reader = res.body.getReader(), dec = new TextDecoder();
      let buf = "";
      for (;;) {
        const { value, done } = await reader.read();
        if (done) break;
        idle();
        buf += dec.decode(value, { stream: true });
        let i;
        while ((i = buf.indexOf("\n\n")) >= 0) {
          const chunk = buf.slice(0, i); buf = buf.slice(i + 2);
          const data = chunk.split("\n").filter((l) => l.startsWith("data: ")).map((l) => l.slice(6)).join("\n");
          if (data && /^event: tasks$/m.test(chunk)) changed(JSON.parse(data));
          if (data && /^event: history$/m.test(chunk)) loginNews(JSON.parse(data).login);
        }
      }
    } catch {}
    clearTimeout(quiet);
    // The server went away (restarting, most likely): try again, and start it ourselves if it stays down.
    await Bun.sleep(1000);
    if (++misses >= 5) { await ensureServer(); misses = 0; }
  }
}
