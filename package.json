{
  "name": "erga",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "bun client/build.ts",
    "start": "bun dev/start.ts",
    "test": "bun e2e/run.ts",
    "format": "bun dev/format.ts --write",
    "lint": "biome lint .",
    "typecheck": "node --no-experimental-webstorage -e \"import('vite').then((v) => v.resolveConfig({}, 'serve'))\" && tsc -p . && tsc -p tsconfig.workers.json && tsc -p tsconfig.browser.json",
    "deploy": "bun deploy/run.ts production",
    "deploy:staging": "bun deploy/run.ts staging",
    "setup:staging": "bun deploy/setup.ts",
    "release": "bun deploy/release.ts",
    "test:prod": "bun e2e/full/suite/prod.ts",
    "test:full": "bun e2e/run.ts --full",
    "test:e2e": "bun e2e/run.ts --e2e",
    "test:browsers": "bunx @e2e-dev/web install chromium",
    "bench": "bun e2e/bench/run.ts"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@effect/ai-anthropic": "4.1.0",
    "@lezer/highlight": "1.2.5",
    "diff": "8.0.2",
    "effect": "4.1.0",
    "lib0": "0.2.119",
    "modern-screenshot": "4.7.0",
    "pdf-lib": "1.17.1",
    "unpdf": "1.4.0",
    "y-protocols": "1.0.7",
    "y-websocket": "3.1.0",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@cloudflare/vite-plugin": "2.0.0-beta.sha-ad79608dd",
    "@e2e-dev/web": "0.13.0",
    "@types/bun": "1.4.2",
    "@types/node": "26.6.4",
    "cf": "1.0.0-beta.10",
    "e2e": "0.18.0",
    "playwright-core": "1.63.0",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  }
}
