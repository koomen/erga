{
  "name": "erga",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "./build.sh",
    "start": "bun dev.ts",
    "test": "bun e2e/run.ts",
    "typecheck": "node -e \"import('vite').then((v) => v.resolveConfig({}, 'serve'))\" && tsc -p . && tsc -p worker",
    "site": "./site.sh",
    "deploy": "bun deploy/run.ts production",
    "deploy:staging": "bun deploy/run.ts staging",
    "setup:staging": "bun deploy/setup.ts",
    "release": "bun deploy/release.ts",
    "test:prod": "bun e2e/full/suite/prod.ts",
    "test:full": "bun e2e/run.ts --full",
    "test:e2e": "bun e2e/run.ts --e2e",
    "test:browsers": "bunx @e2e-dev/web install chromium"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.91.1",
    "@codemirror/commands": "6.11.1",
