.DS_Store
node_modules

# Local environment files. Keep .env.example files committed.
**/.env
**/.env.*
!**/.env.example

# cf build output and local state (and Vite's cache, vite.config.ts)
.cloudflare/
# A running dev server's address (dev/start.ts)
.dev-url
# The client's build (client/build.ts) and the release in it (deploy/release.ts)
.build/
.dev.vars
.dev.vars.*
!.dev.vars.example
# Keys and certificates
*.pem
*.key

.claude/worktrees/
# Agents' worktrees inside the checkout: Biome and the tests must not read their files as this checkout's.
/worktrees/

# The builder image's dependency cache, staged by deploy/setup.ts for its build only
deploy/builder/deps/

# The end-to-end tests: their report, traces and screenshots (e2e.config.ts)
.e2e/
.e2e-alone/

# The load benchmark's results (e2e/bench/run.ts)
.bench/

# Your own Erga's settings and secrets (bun erga own: deploy/own/store.ts)
.erga/
