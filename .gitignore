.DS_Store
node_modules

# Local environment files. Keep .env.example files committed.
**/.env
**/.env.*
!**/.env.example

# cf build output and local state (and Vite's cache, vite.config.ts)
.cloudflare/
# A running dev server's address (dev.ts)
.dev-url
.site/
# The editor's bundles once lived at the root (build.sh writes them into .site/ now): an old checkout's copies stay out.
/page.js
/frame.js
/settings.js
/pages-tree.js
/admin-nav.js
/admin-share.js
/live.js
.site.*/
.dev.vars
.dev.vars.*
!.dev.vars.example
# Keys and certificates
*.pem
*.key

.claude/worktrees/

# The builder image's dependency cache, staged by deploy/setup.ts for its build only
deploy/builder/deps/

# The end-to-end tests: their report, traces and screenshots (e2e.config.ts)
.e2e/
.e2e-alone/
