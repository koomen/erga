// The browser's bundles (client/build.ts makes them): DOM types, no Bun. See tsconfig.json.
{
  "extends": "./tsconfig.json",
  "compilerOptions": { "types": [] },
  "include": ["client", "libs", "shared"],
  // The build script runs under Bun: tsconfig.json checks it.
  "exclude": ["client/build.ts"]
}
