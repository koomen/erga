// The builder Worker's own config (deploy/builder/worker.ts). It isn't the
// app: it's deployed once, apart, with `bunx wrangler deploy` from this
// folder (deploy/setup.ts does it, after asking). Its container image is
// Dockerfile here. Each build has its own container (worker.ts): up to 4 at once, each
// standard-4 (4 vCPU, 12 GiB, 20 GB disk), the largest Cloudflare Containers offers
// (custom instance types go no higher: developers.cloudflare.com/containers, limits).
// A change here takes a deploy of the builder: bun deploy/setup.ts --builder.
{
  "name": "erga-builder",
  "main": "worker.ts",
  "compatibility_date": "2026-09-30",
  // The Worker's version id, which every deploy of the builder (and so every new image) changes: the release cache's key (cache.ts).
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "workers_dev": false,
  "preview_urls": false,
  "containers": [
    { "class_name": "Builder", "image": "./Dockerfile", "instance_type": "standard-4", "max_instances": 4 }
  ],
  "durable_objects": { "bindings": [{ "name": "BUILDS", "class_name": "Builder" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Builder"] }],
  "observability": { "enabled": true, "logs": { "enabled": true } }
}
