{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/erga-agent",
            "args": ["hook", "--agent", "claude-code"],
            "timeout": 5
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/erga-agent",
            "args": ["wait", "--agent", "claude-code"],
            "asyncRewake": true,
            "timeout": 604800
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/erga-agent",
            "args": ["hook", "--agent", "claude-code"],
            "timeout": 5
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/erga-agent",
            "args": ["wait", "--agent", "claude-code"],
            "asyncRewake": true,
            "timeout": 604800
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/erga-agent",
            "args": ["hook", "--agent", "claude-code"],
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/erga-agent",
            "args": ["hook", "--agent", "claude-code"],
            "timeout": 600
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/erga-agent",
            "args": ["hook", "--agent", "claude-code"],
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "mcp__.*__erga_open",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/erga-agent",
            "args": ["wait", "--agent", "claude-code"],
            "asyncRewake": true,
            "timeout": 604800
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/erga-agent",
            "args": ["hook", "--agent", "claude-code"],
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/erga-agent",
            "args": ["hook", "--agent", "claude-code"],
            "timeout": 5
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/erga-agent",
            "args": ["wait", "--agent", "claude-code"],
            "asyncRewake": true,
            "timeout": 604800
          }
        ]
      }
    ]
  }
}
