// The control Worker's own config (control/index.ts): its bindings, without
// the deployment's names. deploy/targets.json has those (the Worker's name and
// hostname, production's database, the Artifacts namespace, the release
// store's bucket, the account, the admins, the GitHub App's and OAuth client's
// ids), and deploy/targets.ts controlWrangler fills them in. Deployed the
// first time by deploy/setup.ts --control, which runs `bunx wrangler deploy`
// on the filled-in config: wrangler builds the container image
// (builder/Dockerfile) with Docker, pushes it, and uploads the Worker.
// After that it deploys itself, from main after production (deploy/control.ts):
// deploy/release.ts reads the filled-in config into each release, and the pipeline
// uploads the Worker with these bindings (a Durable Object class matched to
// its namespace, the container's class named so the container stays). So a
// change here that adds a Durable Object class, or a change to the image,
// needs --control again; anything else goes with main. Its secrets
// (SESSION_SECRET, SNAPSHOT_TOKEN, and the GitHub App's: GITHUB_APP_CLIENT_SECRET,
// GITHUB_APP_PRIVATE_KEY as PKCS#8 PEM, GITHUB_WEBHOOK_SECRET) are set from files by
// the setup (`wrangler secret put <NAME> --name erga-control < file`), never
// printed, and kept; its Cloudflare credential is an OAuth grant (Connect
// Cloudflare on the Ops page), kept in its pipeline object.
//
// The build containers: one per build, up to 4 at once, each standard-4
// (4 vCPU, 12 GiB, 20 GB disk), the largest Cloudflare Containers offers.
{
  "main": "index.ts",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["nodejs_compat"],
  // The Worker's version id, which every deploy (and so every new image) changes: the release cache's key, and what /api/health answers.
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "workers_dev": false,
  "preview_urls": false,
  "containers": [
    { "class_name": "Builder", "image": "./builder/Dockerfile", "instance_type": "standard-4", "max_instances": 4 }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "BUILDS", "class_name": "Builder" },
      { "name": "PIPELINE", "class_name": "Pipeline" },
      { "name": "SOURCE", "class_name": "SourceHost" },
      { "name": "DEPLOYS", "class_name": "Deployer" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Builder", "Pipeline", "SourceHost"] }, { "tag": "v2", "new_sqlite_classes": ["Deployer"] }],
  // Production's database: who is an admin, and the admin-scope tokens (deploy/targets.json: production's `database`; the setup finds its id).
  "d1_databases": [{ "binding": "DB" }],
  // Erga's repository (deploy/targets.json: source.namespace).
  "artifacts": [{ "binding": "ARTIFACTS" }],
  // The release store (deploy/releases.ts): every release production deployed, served at /releases/ for anyone. deploy/setup.ts makes
  // the bucket (deploy/targets.json: control.releases).
  "r2_buckets": [{ "binding": "RELEASES" }],
  // The text bindings come from deploy/targets.json (targets.ts controlVars): ADMINS, CLOUDFLARE_ACCOUNT_ID, APP_URL (production's
  // address), and control.vars there: Erga's GitHub App (GITHUB_APP_ID, GITHUB_APP_SLUG, GITHUB_APP_CLIENT_ID: sign-in here, with
  // the callback https://<control host>/auth/github/callback; Connect GitHub on the Ops page; its webhook,
  // https://<control host>/github/webhook, push events; its secrets are secrets, above), and Erga's OAuth client on Cloudflare
  // (CLOUDFLARE_OAUTH_CLIENT_ID: Manage account › OAuth clients, redirect https://<control host>/install/callback; an admin's
  // consent on the Ops page gives this Worker its deploy credential, deploy/credential.ts).
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": true } }
}
